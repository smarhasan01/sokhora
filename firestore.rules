rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@shokhora\\.com') ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Customers cannot set or alter their own admin role
      allow create, update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable through Firebase Admin SDK or Console
    }

    // 3. Products
    match /products/{productId} {
      allow read: if true; // Public catalog browsing
      allow create, update, delete: if isAdmin();
    }

    // 4. Categories
    match /categories/{categoryId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }

    // 5. Orders
    match /orders/{orderId} {
      // Guests and registered customers can create orders
      allow create: if request.resource.data.orderStatus == 'Pending';
      // Customers can read their own order; Admins can read all orders
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Only Admins can modify status, payment records, or internal notes
      allow update, delete: if isAdmin();
    }

    // 6. Payments
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Handled securely via Server Actions or Admin SDK
    }

    // 7. Receipts
    match /receipts/{receiptId} {
      allow read: if true; // Verifiable via receipt number
      allow write: if isAdmin();
    }

    // 8. Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Inventory audit movements
    match /inventory/{movementId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 10. Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Customer Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // 12. Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
  }
}
