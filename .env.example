# ====================================================================
# SHOKHORA (শখোরা) E-COMMERCE — ENVIRONMENT CONFIGURATION
# ====================================================================

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Firebase Client SDK Configuration (Client-side)
# Obtain these from your Firebase Console > Project Settings > General > Your Apps
# --------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-side ONLY)
# Never expose these keys to client-side code!
# Obtain from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# --------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------------
# Bangladeshi Payment Gateway (SSLCOMMERZ) — Server-side ONLY
# Leave blank for staging / manual bKash & Nagad payments.
# --------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_IS_LIVE=false
